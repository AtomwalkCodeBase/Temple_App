{
  "expo": {
    "name": "Agam Mandira",
    "slug": "agam-mandira",
    "scheme": "com.atomwalk.templedevotee",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agam.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.agam.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#FCFAF6"
      },
      "permissions": [
        "NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#7A263A"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo-diya.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCFAF6"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "@react-native-vector-icons/ionicons"
    ],
    "extra": {
      "eas": {
        "projectId": "d61668a0-8952-499f-a569-01b4d3b1d836"
      }
    },
    "owner": "atomwalk",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d61668a0-8952-499f-a569-01b4d3b1d836"
    }
  }
}
